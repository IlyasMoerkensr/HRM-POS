# Wordt bij de eerste start automatisch gekopieerd naar .env (start.bat).
# .env staat NIET in git. Pas daar je Mollie-sleutel aan.

# Database: SQLite-bestand prisma/kassa.db op deze pc
DATABASE_URL="file:./kassa.db"

# Mollie Dashboard → Developers → API-sleutels. Begin met test_..., later live_...
# Leeg laten = alleen handmatig bevestigen van pinbetalingen (modus C).
MOLLIE_API_KEY=""

# Optioneel: advanced access token (Dashboard → Developers → API keys → advanced access token)
# met recht settlements.read — nodig voor uitbetalingen + transactiekosten.
MOLLIE_ORG_ACCESS_TOKEN=""

# Optioneel: extra backupmap, bijv. in OneDrive of Google Drive:
# BACKUP_DIR="C:\Users\Kassa\OneDrive\Kassa-backups"
BACKUP_DIR=""

# Optioneel: deep link naar de Mollie Tap-app (zie mollieService.ts)
MOLLIE_TAP_DEEPLINK_TEMPLATE=""

# Alleen bij hosten op een publiek https-adres (niet nodig bij lokaal draaien)
PUBLIC_BASE_URL=""

# Worden automatisch ingevuld door start.bat — niet delen:
SESSION_SECRET=""
PAIRING_CODE=""
CRON_SECRET=""
