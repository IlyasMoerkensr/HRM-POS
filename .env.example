# Kopieer naar .env en vul in. .env staat NIET in git.

# Database (SQLite-bestand naast prisma/schema.prisma)
DATABASE_URL="file:./kassa.db"

# Mollie Dashboard → Developers → API-sleutels. Begin met test_..., later live_...
MOLLIE_API_KEY="test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Optioneel: organisatie-token (Dashboard → Developers → Organisatie-tokens)
# met recht settlements.read — nodig voor uitbetalingen + transactiekosten.
MOLLIE_ORG_ACCESS_TOKEN=""

# Optioneel: publiek https-adres van deze kassa (voor Mollie-webhooks).
# Leeg laten bij alleen lokaal draaien: dan gebruikt de kassa polling.
PUBLIC_BASE_URL=""

# Optioneel: deep link naar de Mollie Tap-app (modus B), zie mollieService.ts
MOLLIE_TAP_DEEPLINK_TEMPLATE=""

# Geheim voor /api/cron/reconcile (automatische dagcontrole)
CRON_SECRET="verander-mij-in-een-lange-willekeurige-tekst"
